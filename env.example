# ===== NVIDIA NIM API 配置 =====
# 免费试用 Key 申请：https://build.nvidia.com/settings
# 所有模型共用同一个 OpenAI 兼容端点
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# 视觉模型（九宫格/滑块识别，必须支持图像输入）
NVIDIA_MODEL_VISION=nvidia/nemotron-3.5-super-vl-120b-a12b

# 视觉备用模型（主模型返回 429 / 5xx 时自动切换）
NVIDIA_MODEL_VISION_FALLBACK=z-ai/glm-5.3-flash

# 文本模型（用于语义裁决）
NVIDIA_MODEL_TEXT=z-ai/glm-5.3-flash

# 查询可用模型 id（无需鉴权）：
#   curl -s https://integrate.api.nvidia.com/v1/models | grep -o '"id":"[^"]*"'

# AI 调用失败重试次数（网络抖动/限流时生效）
AI_CALL_MAX_RETRIES=2

# 逐格识别并发数（建议 2-3，免费额度下过高易触发限流）
AI_CELL_WORKERS=2

# 定时执行时间（格式：HH:MM，如 08:00）
# 脚本会在指定时间±30分钟内随机选择一个秒级时间点执行
# 例如：设置为 08:00，则会在 07:30:00 到 08:30:00 之间随机执行
SCHEDULE_TIME=08:00

# HTTP代理配置（可选）
# 如果服务器需要代理才能访问目标网站，请配置此项
# 例如：HTTP_PROXY=http://127.0.0.1:7890
# 留空表示不使用代理
HTTP_PROXY=

# 是否复用 state.json 登录态缓存
# 建议关闭（false），避免历史会话导致账号/流量状态误判
USE_STATE_CACHE=false

# 验证码额外重试轮配置（可选）
# 当验证码场景基础尝试失败后，是否再追加一轮尝试
CAPTCHA_EXTRA_ROUND_ENABLED=true
# 额外轮追加的尝试次数（建议 1-3）
CAPTCHA_EXTRA_ROUND_ATTEMPTS=2

# ===== 邮件通知 =====
# 本仓库默认关闭，需要时改为 true 并补齐下面的 SMTP 配置
EMAIL_NOTIFY_ENABLED=false
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_TO=

# 通知策略（控制"每天都收到邮件"的问题）
#   none         = 从不发邮件
#   failure_only = 仅最终失败时发（默认，推荐）
#   change       = 最终失败 + 当天首次签到成功；"今日已签到"不发
#   all          = 每次运行都发（旧行为）
EMAIL_NOTIFY_POLICY=failure_only

# 连续失败告警邮件（与失败邮件内容重复，默认关闭避免一次失败收两封）
FAIL_ALERT_ENABLED=false
FAIL_ALERT_THRESHOLD=2

# 外层脚本级重试次数（每轮完整执行一次 main.py）
CHECKIN_MAX_RETRIES=5

# 外层脚本级重试间隔（秒）
CHECKIN_RETRY_INTERVAL_SECONDS=30